# TEMPLATE ONLY — copy to `android/keystore.properties` (gitignored) and fill in real values.
# NEVER commit the real keystore.properties or the .jks file (both are already gitignored).
# Without this file present, a RELEASE build fails clearly (it never debug-signs silently).
# Create the keystore via Android Studio (Build > Generate Signed Bundle/APK > Create new…)
# or keytool; see MOBILE-ANDROID-SIGNING-REPORT.md for exact steps.
storeFile=bispun-release.jks
storePassword=CHANGE_ME
keyAlias=bispun-release
keyPassword=CHANGE_ME
