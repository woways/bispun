generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  MANAGER
  EMPLOYEE
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  COUNSELLING
  ADMITTED
  LOST
}

enum AdmissionStatus {
  PENDING
  ONGOING
  COMPLETED
  CANCELLED
}

enum AdmissionRevenueStatus {
  IN_BUCKET
  BUFFER_ZONE
}

enum AdmissionAmountStatus {
  RECEIVED
  PENDING
}

enum WalkInStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  LOST
}

enum CounsellingStatus {
  SCHEDULED
  FOLLOW_UP
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IncentiveStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum LeadDatasetType {
  EXTERNAL_DATA
  OFFLINE_LEADGEN
  PURCHASED
  UPLOADED
  ASSIGNED
}

enum CustomFieldEntityType {
  LEAD
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
  DATE
  CHECKBOX
  EMAIL
  PHONE
}

enum SupportTicketType {
  TECHNICAL_ISSUE
  FEATURE_REQUEST
  CUSTOMIZATION
  INTEGRATION
  BILLING
  CALL_TO_RM
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  IN_PROGRESS
  DEVELOPMENT
  RM_ASSIGNED
  CALL_SCHEDULED
  DISCUSSION_COMPLETED
  FOLLOW_UP_REQUIRED
  COMPLETED
  REJECTED
  CLOSED
}

enum CalendarEventType {
  MEETING
  FOLLOW_UP
  COUNSELLING
  ADMISSION
  PAYMENT
  REMINDER
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum WebsiteLeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  DEMO_SCHEDULED
  WON
  LOST
}

enum ReferralPayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Company {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  brandName    String?
  shortName    String?
  business     String?
  ownerName    String?
  city         String?
  email        String?
  phone        String?
  logoUrl      String?
  primaryColor String?
  subdomain    String? @unique

  status CompanyStatus @default(TRIAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  subscriptions  Subscription[]
  companyModules CompanyModule[]
  settings       CompanySettings?

  leads                   Lead[]
  utmLinks                UtmLink[]
  admissions              Admission[]
  expenses                Expense[]
  incentives              Incentive[]
  leadDatasets            LeadDataset[]
  supportTickets          SupportTicket[]
  notifications           Notification[]
  payments                PaymentTransaction[]
  leadSources             LeadSourceConfig[]
  customFields            CustomField[]
  notificationPreferences UserNotificationPreference[]
  auditLogs               AuditLog[]
  walkIns                 WalkIn[]
  counsellingSessions     CounsellingSession[]
  admissionPartners       AdmissionPartner[]
  admissionStreams        AdmissionStream[]
  admissionBranches       AdmissionBranch[]
  calendarEvents          CalendarEvent[]
  workspaceYears          CompanyWorkspaceYear[]
  clientSessions          ClientSession[]
  conversations           Conversation[]
  targetTasks             TargetTask[]
  monthlyTargets          MonthlyTarget[]
  referrals               Referral[]
  crmReferral             CrmReferral? @relation("ReferredCompany")
  storeAssets             StoreAsset[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  role         UserRole @default(EMPLOYEE)

  active Boolean @default(true)

  phone          String?
  jobTitle       String?
  department     String?
  referralCode   String? @unique
  employeeId     String?
  customRoleId   String?
  customRoleName String?

  sidebarOrder String[] @default([])

  canManageUsers      Boolean @default(false)
  canManageSettings   Boolean @default(false)
  canManageBilling    Boolean @default(false)
  canViewAnalytics    Boolean @default(false)
  canManageAdmissions Boolean @default(false)
  canManageRevenue    Boolean @default(false)
  canManageLeads      Boolean @default(false)
  canManageSupport    Boolean @default(false)
  canViewTeamTargets  Boolean @default(false)

  // Granular in-page access (admissions stream/college/branch scoping, finance
  // & insights section toggles). Null / absent => governed purely by the legacy
  // boolean flags above with full in-page access. See server/lib/pageAccess.js.
  pageAccess Json?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Reporting hierarchy: an employee reports to a manager (self-relation).
  managerId String?
  manager   User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]   @relation("TeamManager")

  // Google Calendar / Meet integration (per-user OAuth).
  googleRefreshToken String?
  googleEmail        String?
  googleConnectedAt  DateTime?
  googleScopes       String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incentives             Incentive[]
  notifications          Notification[]
  payments               PaymentTransaction[]
  notificationPreference UserNotificationPreference?
  auditLogs              AuditLog[]
  assignedLeadDatasets   LeadDataset[]               @relation("LeadDatasetAssignee")
  calendarEventsCreated  CalendarEvent[]             @relation("CalendarEventCreator")
  calendarEventsAssigned CalendarEvent[]             @relation("CalendarEventAssignee")
  clientSessions         ClientSession[]
  chatMemberships        ConversationMember[]        @relation("ChatMember")
  chatMessages           ChatMessage[]               @relation("ChatSender")
  chatReactions          ChatReaction[]              @relation("ChatReactionUser")
  chatMessageStars       ChatMessageStar[]           @relation("ChatMessageStarUser")
  chatMessageDeletions   ChatMessageDeletion[]       @relation("ChatMessageDeletionUser")
  targetTasksOwned       TargetTask[]                @relation("TargetOwner")
  targetTasksAssigned    TargetTask[]                @relation("TargetAssigner")
  monthlyTargets         MonthlyTarget[]             @relation("MonthlyTargetOwner")
  referrals              Referral[]                  @relation("ReferralReferrer")
  crmReferrals           CrmReferral[]               @relation("CrmReferralReferrer")
  referralPayoutRequests ReferralPayoutRequest[]     @relation("ReferralPayoutReferrer")
  rmSupportTickets       SupportTicket[]             @relation("SupportTicketAssignedRM")

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([companyId, role])
  @@index([companyId, active])
  @@index([companyId, managerId])
}

model ClientSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?

  deviceType String?
  deviceName String?
  browser    String?
  os         String?

  city    String?
  country String?

  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  endReason    String?

  @@index([userId, revokedAt, expiresAt])
  @@index([companyId, userId])
  @@index([lastActiveAt])
}

model Plan {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  tagline     String?

  // Legacy compatibility only; annual pricing is the active billing source.
  monthlyPrice Decimal  @default(0) @db.Decimal(12, 2)
  yearlyPrice  Decimal? @db.Decimal(12, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  planModules   PlanModule[]
  payments      PaymentTransaction[]
}

model Module {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  icon        String?
  route       String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planModules    PlanModule[]
  companyModules CompanyModule[]
}

model PlanModule {
  id String @id @default(cuid())

  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
}

model CompanyModule {
  id String @id @default(cuid())

  companyId String
  moduleId  String

  enabled Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
}

model Subscription {
  id String @id @default(cuid())

  companyId String
  planId    String

  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(YEARLY)

  startDate   DateTime  @default(now())
  renewalDate DateTime?
  endDate     DateTime?

  // Pricing breakdown. listPrice = plan price before discount,
  // discountAmount = flat rupee discount set by Super Admin,
  // amount = final amount the client pays (listPrice - discountAmount).
  listPrice      Decimal? @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  amount         Decimal? @db.Decimal(12, 2)

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan                 @relation(fields: [planId], references: [id])
  payments PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([planId])
}

model PaymentTransaction {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  initiatedByUserId String?
  initiatedByUser   User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  provider PaymentProvider @default(RAZORPAY)
  status   PaymentStatus   @default(CREATED)

  billingCycle BillingCycle @default(YEARLY)

  // Pricing breakdown for the invoice/receipt. amount = final amount charged.
  listPrice      Decimal? @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")

  providerOrderId   String  @unique
  providerPaymentId String? @unique

  receipt String?

  failureCode   String?
  failureReason String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([subscriptionId])
  @@index([planId])
  @@index([initiatedByUserId])
}

model CompanyWorkspaceYear {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  structureMode  String   @default("EMPTY")
  copiedFromYear Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, year])
  @@index([companyId, year])
}

model CompanySettings {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  portalName         String?
  logoUrl            String?
  primaryColor       String?
  secondaryColor     String?
  timezone           String  @default("Asia/Kolkata")
  currency           String  @default("INR")
  dateFormat         String  @default("DD/MM/YYYY")
  organizationConfig Json?

  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UtmLink {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaign String
  source   String
  medium   String
  url      String

  clicks        Int @default(0)
  registrations Int @default(0)
  conversions   Int @default(0)
  admissions    Int @default(0)

  revenue Decimal @default(0) @db.Decimal(14, 2)
  cost    Decimal @default(0) @db.Decimal(14, 2)

  active Boolean @default(true)

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, campaign])
}

model LeadCommunication {
  id String @id @default(cuid())

  companyId String
  userId    String
  leadId    String?

  channel String
  status  String

  sender    String?
  recipient String
  subject   String?
  message   String @db.Text

  providerMessageId String?
  errorMessage      String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, leadId, createdAt])
  @@index([userId, createdAt])
  @@index([channel, status])
}

model LeadSourceConfig {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key  String
  name String

  description String?

  active      Boolean @default(true)
  showInForms Boolean @default(true)
  system      Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
}

model Lead {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  course String?

  source String
  stage  LeadStage @default(NEW)

  campaign String?
  medium   String?

  assignedToName String?

  utmLinkId String?
  utmLink   UtmLink? @relation(fields: [utmLinkId], references: [id], onDelete: SetNull)

  notes String?

  admission         Admission?
  customFieldValues CustomFieldValue[]

  referral Referral?

  leadDatasetId String?
  leadDataset   LeadDataset? @relation(fields: [leadDatasetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, source])
  @@index([companyId, stage])
  @@index([companyId, createdAt])
  @@index([utmLinkId])
  @@index([leadDatasetId])
  @@index([companyId, leadDatasetId])
}

enum AdmissionMarket {
  DOMESTIC
  INTERNATIONAL
}

model Admission {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  market AdmissionMarket @default(DOMESTIC)

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Stores the lead stage that existed before this admission was created.
  // This lets cancellation/deletion restore the CRM lead correctly.
  leadStageBeforeAdmission LeadStage?

  studentName         String
  studentPhone        String?
  studentAltPhone     String?
  studentEmail        String?
  universityName      String?
  studentLocation     String?
  studentInterCollege String?

  partnerId String?
  partner   AdmissionPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  branchId String?
  branch   AdmissionBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  college String
  // Kept for backward compatibility and exports. New admissions mirror branch.name here.
  course  String

  counsellorName String?

  // Financial fields retain their database names for backwards compatibility.
  // In the Bispun UI these are shown as Incentive Amount and Received Amount.
  totalFee   Decimal @default(0) @db.Decimal(14, 2)
  paidAmount Decimal @default(0) @db.Decimal(14, 2)

  revenueStatus AdmissionRevenueStatus @default(BUFFER_ZONE)
  amountStatus  AdmissionAmountStatus?

  status AdmissionStatus @default(ONGOING)

  admissionDate DateTime @default(now())

  notes String?

  incentives Incentive[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, revenueStatus])
  @@index([companyId, amountStatus])
  @@index([companyId, admissionDate])
  @@index([partnerId])
  @@index([companyId, partnerId])
  @@index([branchId])
  @@index([companyId, branchId])
}

model AdmissionStream {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  market AdmissionMarket @default(DOMESTIC)

  name String
  slug String

  description String?
  color       String  @default("blue")
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  partners AdmissionPartner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
}

model AdmissionPartner {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  market AdmissionMarket @default(DOMESTIC)

  streamId String?
  stream   AdmissionStream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  name String
  slug String

  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  branches   AdmissionBranch[]
  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
  @@index([streamId])
  @@index([companyId, streamId])
}

model AdmissionBranch {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  market AdmissionMarket @default(DOMESTIC)

  partnerId String
  partner   AdmissionPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  name String
  slug String

  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, partnerId, slug])
  @@index([companyId, partnerId, active])
  @@index([companyId, sortOrder])
}

model WalkIn {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  market AdmissionMarket @default(DOMESTIC)

  visitorName    String
  studentName    String?
  phone          String
  alternatePhone String?
  email          String?
  course         String?

  purpose        String
  accompaniedBy  String?
  counsellorName String?
  outcome        String?

  status WalkInStatus @default(NEW)

  arrivedAt DateTime @default(now())

  convertedLeadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, arrivedAt])
  @@index([companyId, phone])
  @@index([convertedLeadId])
}

model CounsellingSession {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  market AdmissionMarket @default(DOMESTIC)

  leadId String?

  studentName  String
  studentPhone String?
  studentEmail String?

  course         String?
  counsellorName String?
  mode           String  @default("IN_PERSON")
  meetingLink    String?
  accompaniedBy  String?

  scheduledAt DateTime

  status CounsellingStatus @default(SCHEDULED)

  remarks    String?
  followUpAt DateTime?

  converted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@index([companyId, leadId])
  @@index([companyId, counsellorName])
}

model Expense {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  category    String
  description String?

  amount Decimal @db.Decimal(14, 2)

  expenseDate DateTime @default(now())

  submittedByName String?
  approvedByName  String?

  paymentMode    String?
  transactionRef String?
  vendorName     String?
  invoiceNumber  String?
  receiptUrl     String?

  status ExpenseStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, expenseDate])
}

model Incentive {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  admissionId String?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  employeeName String

  title       String?
  description String?

  amount Decimal @db.Decimal(14, 2)

  incentiveDate DateTime @default(now())

  status IncentiveStatus @default(PENDING)

  approvedByName String?
  paidDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, incentiveDate])
  @@index([userId])
  @@index([admissionId])
}

model LeadDataset {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  type LeadDatasetType

  sourceName String?

  sourceFileName String?

  leadCount      Int @default(0)
  importedCount  Int @default(0)
  duplicateCount Int @default(0)
  failedCount    Int @default(0)
  convertedCount Int @default(0)

  assignedToUserId String?
  assignedToUser   User?   @relation("LeadDatasetAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  notes String?

  uploadedAt DateTime @default(now())

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, uploadedAt])
  @@index([assignedToUserId])
}

model SupportTicket {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ticketNumber String @unique

  title       String
  description String

  type SupportTicketType

  priority SupportTicketPriority @default(MEDIUM)

  status SupportTicketStatus @default(NEW)

  submittedByName  String?
  submittedByEmail String?
  department       String?

  // Relationship Manager call request details. These remain null for normal support tickets.
  discussionCategory String?
  preferredCallDate  DateTime? @db.Date
  preferredTimeSlot  String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?

  assignedRmUserId String?
  assignedRmUser   User?   @relation("SupportTicketAssignedRM", fields: [assignedRmUserId], references: [id], onDelete: SetNull)

  scheduledCallAt DateTime?

  adminRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resolvedAt DateTime?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([assignedRmUserId])
  @@index([scheduledCallAt])
  @@index([createdAt])
}

model UserNotificationPreference {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean?
  smsEnabled   Boolean?

  leadUpdates      Boolean @default(true)
  admissionUpdates Boolean @default(true)
  billingUpdates   Boolean @default(true)
  supportUpdates   Boolean @default(true)
  systemUpdates    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, userId])
}

model Notification {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    String @default("INFO")

  actionModule String?
  actionLabel  String?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, read])
  @@index([userId, read])
}

model CustomField {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType CustomFieldEntityType @default(LEAD)
  fieldType  CustomFieldType

  name String
  key  String

  description String?

  required    Boolean @default(false)
  showInForms Boolean @default(true)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  options Json?

  values CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, entityType, key])
  @@index([companyId, entityType, active])
  @@index([companyId, entityType, sortOrder])
}

model CustomFieldValue {
  id String @id @default(cuid())

  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customFieldId, leadId])
  @@index([leadId])
  @@index([customFieldId])
}

model AuditLog {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  actorName  String?
  actorEmail String?
  actorRole  String?

  action     String
  entityType String
  entityId   String?

  summary String

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, action])
  @@index([companyId, entityType])
  @@index([actorUserId, createdAt])
}

model SuperAdminAuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actorName   String?
  actorEmail  String?

  action     String
  entityType String
  entityId   String?

  companyId   String?
  companyName String?

  summary  String
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([action])
  @@index([entityType])
}

model SystemSettings {
  id String @id @default(cuid())

  key String @unique @default("global")

  platformName String  @default("ConsulBuzz")
  supportEmail String?
  supportPhone String?

  defaultTimezone   String @default("Asia/Kolkata")
  defaultCurrency   String @default("INR")
  defaultDateFormat String @default("DD/MM/YYYY")

  defaultTrialDays Int @default(14)

  defaultBillingCycle BillingCycle @default(YEARLY)

  defaultEmailNotifications Boolean @default(true)
  defaultSmsNotifications   Boolean @default(false)

  maintenanceMode Boolean @default(false)

  allowNewClientOnboarding Boolean @default(true)

  defaultPrimaryColor String @default("indigo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  description String?

  type   CalendarEventType   @default(MEETING)
  status CalendarEventStatus @default(SCHEDULED)

  startAt DateTime
  endAt   DateTime?

  allDay Boolean @default(false)

  location    String?
  meetingRoom String?

  createdByUserId String?
  createdByUser   User?   @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedToUser   User?   @relation("CalendarEventAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startAt])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([assignedToUserId, startAt])
  @@index([createdByUserId])
}

model Conversation {
  id        String  @id @default(cuid())
  isGroup   Boolean @default(false)
  name      String? // group name; null for 1-to-1
  avatarUrl String? // group photo; null for 1-to-1
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members  ConversationMember[]
  messages ChatMessage[]

  @@index([companyId])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ChatMember", fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())
  isFavorite Boolean   @default(false)
  isMuted    Boolean   @default(false)
  isArchived Boolean   @default(false)
  clearedAt  DateTime?
  hiddenAt   DateTime?
  nickname   String?

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  body                 String
  createdAt            DateTime  @default(now())
  pinned               Boolean   @default(false)
  deletedForEveryoneAt DateTime?

  replyToId   String?
  replyTo     ChatMessage?          @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]         @relation("ChatMessageReplies")
  reactions   ChatReaction[]
  stars       ChatMessageStar[]
  attachments ChatAttachment[]
  deletions   ChatMessageDeletion[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model ChatMessageDeletion {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatMessageDeletionUser", fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model ChatAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url          String
  publicId     String
  resourceType String
  fileName     String
  mimeType     String
  size         Int    @default(0)
  width        Int?
  height       Int?

  createdAt DateTime @default(now())

  @@index([messageId])
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageStar {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatMessageStarUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([userId, createdAt])
}

model TargetTask {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("TargetOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title  String
  source TargetSource @default(SELF)

  assignedByUserId String?
  assignedBy       User?   @relation("TargetAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  date DateTime // the day this task is for (date-only, time ignored)

  type         TargetType   @default(CHECKLIST)
  targetValue  Int? // for NUMERIC
  currentValue Int          @default(0)
  status       TargetStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, ownerId, date])
  @@index([ownerId, date])
}

enum TargetSource {
  SELF
  ASSIGNED
}

enum TargetType {
  CHECKLIST
  NUMERIC
}

enum TargetStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model MonthlyTarget {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("MonthlyTargetOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  year  Int
  month Int // 1-12

  monthlyTarget Int   @default(0) // admin-set monthly target (Overall % divides by this)
  weekTarget    Int[] @default([]) // per-week target, admin-set
  weekAchieved  Int[] @default([]) // per-week achieved, employee-set

  setByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, ownerId, year, month])
  @@index([companyId, year, month])
}

model Referral {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  referrerId String
  referrer   User   @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([referrerId])
}


model CrmReferral {
