# ---------------------------------------------------------------------------
# Bispun environment template
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# never committed. The SERVER reads most of these; the only build-time value
# the FRONTEND/mobile bundle needs is VITE_API_URL below.
# ---------------------------------------------------------------------------

# === Mobile / frontend build (REQUIRED for the Capacitor Android/iOS app) ===
# Vite bakes this into the built bundle, so it must point at a backend the
# phone can actually reach. Pick the value for how you run the app:
#
#   Android EMULATOR (Android Studio)  -> http://10.0.2.2:4000
#       (10.0.2.2 is the emulator's alias for your PC's localhost)
#   Physical Android phone (same Wi-Fi) -> http://<your-PC-LAN-IP>:4000
#       (find it with `ipconfig`; e.g. http://192.168.1.23:4000)
#   Production / released app           -> https://api.yourdomain.com
#
# NOTE: a production `npm run build` THROWS if this is empty, and the app
# shows a blank screen. Always set it before building the mobile app.
VITE_API_URL=http://10.0.2.2:4000

# === Server core (REQUIRED to run the backend; not needed to build the app) ===
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# JWT_SECRET=change-me-to-a-long-random-string   # must be >=32 chars in production
# CLIENT_URL=http://localhost:5173               # comma-separated; must be HTTPS in production
# PORT=4000
# TRUST_PROXY=false                              # set true behind a reverse proxy / load balancer
# DISABLE_BACKGROUND_WORKERS=true                # DEV: disables nurture + calendar-reminder workers (no outbound messages)

# === Google Calendar & Meet (REQUIRED for Calendar/Meet; feature is disabled if unset) ===
# Consumed by server/lib/google.js. Without these, OAuth connect fails and the
# server logs "[config] Google Calendar/Meet disabled". GOOGLE_REDIRECT_URI
# defaults to http://localhost:4000/... in dev — set it explicitly in production
# to your deployed callback or OAuth will fail with a generic error.
# GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/client/google/callback

# === Firebase Cloud Messaging (REQUIRED for mobile push; silent no-op if unset) ===
# Consumed by server/lib/pushService.js. Provide EITHER a JSON service-account
# string OR a path to the credentials file. Never commit the real values.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json

# === Account deletion requests (OPTIONAL; used by /api/public/data-deletion
#     and the in-app request). Where deletion-request notifications are emailed.
#     Falls back to SMTP_USER if unset; requires SMTP_* to actually send. ===
# DATA_DELETION_INBOX=privacy@bispun.com

# === Telephony (OPTIONAL; falls back to device-dial when unset) ===
# Consumed by server/routes/clientTelephony.js.
# TELEPHONY_PROVIDER=
# TELEPHONY_OUTBOUND_URL=
# TELEPHONY_API_KEY=
# TELEPHONY_WEBHOOK_SECRET=

# === Other integrations (set per deployment; see code for exact names) ===
# Payments (Razorpay), email (SMTP/nodemailer), S3 (AWS_* / bucket), WhatsApp —
# required only if you use those modules. Keep all real secrets out of git.
